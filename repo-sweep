#!/usr/bin/env bash
set -e

if [[ $# -ne 3 ]]; then
  echo "Usage: $0 <cc|codex> <repository-folder> <daily|weekly>" >&2
  exit 1
fi

agent=$1
repository_folder=$2
schedule=$3

if [[ $schedule != daily && $schedule != weekly ]]; then
  echo "Choose daily or weekly." >&2
  exit 1
fi

# Homebrew links this command into bin. The prompts live beside the original launcher.
launcher=$(realpath "$0")
prompt_file="$(dirname "$launcher")/$schedule.md"

cd -- "$repository_folder"

case "$agent" in
  cc)
    exec claude --model claude-fable-5-2 --effort xhigh --dangerously-skip-permissions -p < "$prompt_file"
    ;;
  codex)
    exec codex --yolo exec --model gpt-6-astra -c 'model_reasoning_effort="xhigh"' --skip-git-repo-check - < "$prompt_file"
    ;;
  *)
    echo "Choose cc or codex." >&2
    exit 1
    ;;
esac
