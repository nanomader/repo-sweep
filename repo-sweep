#!/usr/bin/env bash
set -e

if [[ $# -ne 3 && ( $# -ne 4 || $4 != --premium-model ) ]]; then
  echo "Usage: $0 <cc|codex> <repository-folder> <daily|weekly> [--premium-model]" >&2
  exit 1
fi

agent=$1
repository_folder=$2
schedule=$3

if [[ $schedule != daily && $schedule != weekly ]]; then
  echo "Choose daily or weekly." >&2
  exit 1
fi

# Homebrew links this command into bin. The prompts live beside the original launcher.
launcher=$(realpath "$0")
prompt_file="$(dirname "$launcher")/$schedule.md"

cd -- "$repository_folder"

case "$agent" in
  cc)
    model=claude-opus-5-5
    if [[ $4 == --premium-model ]]; then model=claude-fable-5-2; fi
    exec claude --model "$model" --effort xhigh --dangerously-skip-permissions -p < "$prompt_file"
    ;;
  codex)
    model=gpt-6.2-sol
    if [[ $4 == --premium-model ]]; then model=gpt-6.2-astra; fi
    exec codex --yolo exec --model "$model" -c 'model_reasoning_effort="xhigh"' --skip-git-repo-check - < "$prompt_file"
    ;;
  *)
    echo "Choose cc or codex." >&2
    exit 1
    ;;
esac
